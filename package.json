{
  "name": "dip-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DIP Explorer - an interactive glossary and playground for Digital Image Processing, powered by OpenCV.js",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-opencv.mjs",
    "prebuild": "node scripts/copy-opencv.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "fuse.js": "^7.5.0",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
